# testenv 설정 예시. `make env-up`이 처음 실행될 때 .env로 복사된다.
# 모든 값은 testenv 전용 테스트 값이다. 실제로 쓰는 비밀번호를 넣지 않는다.
# 원본: Immich 공식 example.env (https://docs.immich.app/install/environment-variables)

# Immich 버전. 팀 합의 없이 바꾸지 않는다. up.sh도 이 값으로 compose 파일을 받는다.
IMMICH_VERSION=v3.3.5

# Compose 프로젝트 이름. 공식 compose의 `name: immich` 대신 이 이름을 써서,
# 같은 컴퓨터의 다른 Immich를 make env-down 등이 건드리지 않게 한다.
COMPOSE_PROJECT_NAME=wetrun-testenv

# 사진 원본과 DB 파일 위치. 모두 data/ 아래에 둔다 (.gitignore 대상)
UPLOAD_LOCATION=./data/library
DB_DATA_LOCATION=./data/postgres

# Postgres 접속 정보 (A-Za-z0-9만 사용)
DB_PASSWORD=postgres
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# seed.py가 만드는 테스트 계정과 앨범 (testenv 전용 값)
IMMICH_URL=http://localhost:2283
TESTENV_ADMIN_EMAIL=teamh@wetrun.test
TESTENV_ADMIN_PASSWORD=testpwd
TESTENV_ADMIN_NAME=Wetrun
TESTENV_ALBUM_NAME=testenv-album

# backup.sh가 쓰는 restic 저장소 (testenv 전용 값. 실행기도 이 값으로 저장소를 연다)
RESTIC_REPOSITORY=./data/restic-repo
RESTIC_PASSWORD=resticpwd
TESTENV_BACKUP_TAG=testenv
